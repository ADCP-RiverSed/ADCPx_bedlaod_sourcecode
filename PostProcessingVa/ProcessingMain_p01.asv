%% This script is for processing and eventually looping sevral directories of PRE-processed ADCP and input table files
maindir = 'C:\Users\slavenc'; % main direcotry 
addpath(genpath([maindir '\OneDrive - NTNU\ADCPdataColin\functiosforprocesingNIWA\AcousticParamters']));
addpath(genpath([maindir '\OneDrive - NTNU\ADCPdataColin\functiosforprocesingNIWA\PhSamplesProcessing']));
addpath(genpath([maindir '\OneDrive - NTNU\ADCPdataColin\functiosforprocesingNIWA\PostProcessingVa']));

addpath(genpath([maindir '\Slaven_PhD\FieldDataProcessing\ReadADCP']));
%% Input general ADCP post processing variables (choice of ADCP should give you the)
ADCP_used = 'RDI1200' %M9 %RD600
submergeDistance = 0.05 % in m % if changes per position use an array that correspond to the numeber of ADCP files
% used frequencies
f12= 1.*(10^6); % Hz frequency of the instrument
% f1= 1*(10^6) % Hz frequency of the instrumen
% f3= 3*(10^6) % Hz frequency of the instrumen
% f06= 0.6*(10^6) % Hz frequency of the instrumen
% f05= 0.5*(10^6) % Hz frequency of the instrumen



%% Read field data (need to make another table here) this is infor from the
% PhSamplesDir= [maindir '\OneDrive - NTNU\Slaven_PhD\RiverPro_BedLoadAlbania\DataForprocessing2026\20170322_Tomorrice_Albania\inputtable'];
PhSamplesDir= [maindir 'C:\Users\slavenc\OneDrive - NTNU\Slaven_PhD\RiverPro_BedLoadAlbania\DataForprocessing2026\20161202_Tomorrice_Albania\inputtable']; 


PhSamplesin = readInputTable_PhSamples(PhSamplesDir, ...
    'AssignToCaller', true, ...
    'AssignToBase', true);
% cross section (slope, Chezzy , Q, etc) THis is Mising for now (maybe to add in the main input table)


%% filtering and processing paramters paramters
filtOUTwin=3; % window size, percentile filtering %% despike treshold percentile filtering, used only if lot of movements MAD filtring 
filtOUTstd=3; % std filtering 
movVelTresh= 0.2; % velocity due to wave movments and needs to be adjusted. 0.2 m/s is pretty high and never meassured in Germany. 
RDICutOFFtrim= 0.009; % cut off for side attached trimern adcp 
Ws_min= 0.005; % min cell size ...needs to be checkd if used/ 
ExtraFilter = 'no'
x0 = [1 1] % fitting optimization for the log law
% clear Q BTvel

%% PART 1   - Apprent bedload velocity filtering and depth processing , this include the water velocity also used in the filtering procedure
% Folder1200 =  [maindir '\OneDrive - NTNU\Slaven_PhD\RiverPro_BedLoadAlbania\DataForprocessing2026\20170322_Tomorrice_Albania\ADCPdata_RiverPro1200\20170322TomorricaFixed_0\20170322_processedADCPdata']
Folder1200 =  [maindir 'C:\Users\slavenc\OneDrive - NTNU\Slaven_PhD\RiverPro_BedLoadAlbania\DataForprocessing2026\20161202_Tomorrice_Albania\20161202Dec2\processedADCPdata']
filePattern1200= sprintf('%s/*mat', Folder1200);
dataADCP1200 = dir(filePattern1200);
% Depth processing 
DepthRNGout = processDepthsRNG(dataADCP1200, PhSamplesin, ...
    'PlotResults', true, ...
    'PlotRows', [1 3 5], ...
    'AssignToCaller', true, ...
    'AssignToBase', true, ...
    'Verbose', true);
close all
% water velocty BT operational data 
WaterProfileOut = processWaterProfile(dataADCP1200, PhSamplesin, ...
    'distanceSonTek', submergeDistance, ...
    'LowerFraction', 0.50, ...
    'PlotResults', true, ...
    'PlotRows', [1 3 7], ...
    'AssignToCaller', true, ...
    'AssignToBase', true, ...
    'Verbose', true);
    
%%  BT filtering all steps, and make possible to choose each filter 
BTvelOut = processBTbedloadVelocity1200(dataADCP1200, PhSamplesin, ...
    'WaterProfileOut', WaterProfileOut, ...
    'CoordinateSystem', 'instrument', ...
    'ApplyBoatMotionFilter', true, ...
    'ApplyMovingMedianFilter', true, ...
    'ApplyExtraPercentileFilter', false, ...
    'ApplyErrorVelocityFilter', true, ...
    'ApplyGPSFilter', false, ...
    'ApplyAttitudeFilter', true, ...
    'ApplyWaterBiasFilter', true, ...
    'ApplyDirectionFilter', true, ...
    'ApplyInstrumentDirectionFilter', true, ...
    'PlotVaTrate', true,...
    'AssignToCaller', true, ...
    'AssignToBase', true, ...
    'WaterBiasReference', 'last2cells', ...
    'WaterBiasComparison', 'component', ...
    'BTerrorMultiplier', 4, ...
    'Verbose', true);

%% Hydraiulic and sed transport parameters Part 2
 ro = 1000; %water density 
 rs = 2650; % sediment particle density
  k = 0.4; % Von Karman const
%calculate hydraulic roughnes (2xD90 assumption)
  ks = 2 .* D90 ./ 1000;
  ks(isnan(ks))=nanmean(ks); % in case ks is one value

x0=[1 1];% log law parameters assigned 
try; ni= WaterViscosity(WT_12); end%ni=1.2*10^-6;
SO = 1 % slope in %
lambda= 0.85 % porosity of mobile bedload, it is used if the emirical formulas do not work in method 1 (kinematic model)
%hidden function (still think the eventual use) NO separate transport
%(gravel, sand) i planned so far. This is Willkcok function
try
    bG = 0.67./(1+exp(1.5-D50g_05./D_g_mean_05')) 
    bS = 0.67./(1+exp(1.5-D50s_05./D_g_mean_05')) 
catch
    bG =nan%
    bS = nan
end
%% Shear stress calcualtions  
ShearStressOut = processShearStress1200( ...
    dataADCP1200, PhSamplesin, WaterProfileOut, ...
    'ni', ni, ...
    'ks', ks, ...
    'SO', SO, ...
    'CZ', [], ...
    'aVanRijn', 1, ...
    'DepthRNGout', DepthRNGout, ...
    'CriticalShieldsMethod', 'both', ...
    'SOIsPermille', false, ...
      'BeamAngleDeg', 20, ...
    'ApplySkinFrictionPartition', true, ...
    'PlotTrateShear', true, ...
    'PlotCriticalComparison', true, ...
    'PlotExcessShear', true, ...
    'AssignToCaller', true, ...
    'AssignToBase', true, ...
    'Verbose', true);
% Reference shear stress basic calulations
close all
%% Transport rate Kinematic mmodel, Method 1
 BedloadTransportOut = processBedloadTrate( ...
      PhSamplesin, ShearStressOut, BTvelOut, ...
      'ni', ni, ...
      'n', 5, ...
      'Ninstrument', 3, ...
      'CbMin', 0.015, ...
      'CbMax', 0.55, ...
      'UseCbFallback', true, ...
      'CbFallback', 0.1, ...
      'CbFinalStatistic', 'mean', ...
      'DthicknessMinFactor', 1, ...
      'DthicknessMaxFactor', 12, ...
      'UseDthicknessFallback', true, ...
      'DthicknessFallbackFactor', 2, ...
      'DthicknessFinalStatistic', 'mean', ...
      'MeasuredTrateToKgFactor', 0.001, ... % use 0.001 for measured g/(m s)
      'PlotFinalTrateComparison', true, ...
      'PlotFinalTrateUseLogAxes', false, ...
      'AssignToCaller', true, ...
      'AssignToBase', true, ...
      'Verbose', true);

%% Acoustic parameters 
% calculate c with Temp and depth function 
 c =soundSpeedSeawater(WT_12, 0.2, Depth_1200)
[Acoustic, ADCPin] = computeADCPacousticParameters(PhSamplesin, ...
    'c',  c, ...
    'rs', rs, ...
    'f12',f12, ...
    'AssignToCaller', true, ...
    'Verbose', true);

%% backscatter 
BackscatterOut  = processBackscatter1200( ...
    dataADCP1200, ...
    PhSamplesin, ...
    DepthRNGout, ...
    BTvelOut, ...
    'kc', 0.60, ...
    'Er', 40, ...
    'C1200', -129, ...
    'alphaSed12', 0, ...
    'Tdespike', 2, ...
    'MM', 1, ...
    'Win', 3, ...
    'UseVelocityFilterMask', true, ...
    'ApplyMethod2Regression', true, ...
    'AssignToCaller', true, ...
    'AssignToBase', false, ...
    'RequireExactVelocityMask', true, ...
    'Verbose', true);

%Check if teh mask velocity impacts

