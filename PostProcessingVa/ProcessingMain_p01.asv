%% Run and save in correct directory  - Format same as 

FolderShear= [maindir, '\OneDrive - NTNU\Slaven_PhD\FieldDataProcessing\DATA\shearDATAnewFilters21boat_T'];
FolderTrates= [maindir,'\OneDrive - NTNU\Slaven_PhD\FieldDataProcessing\DATA\TransportDATnewFilters21boat_T'];
FolderBS= [maindir,'\OneDrive - NTNU\Slaven_PhD\FieldDataProcessing\DATA\BSstrengtgh_VBfilt21boat_T'];

[Data_field, ShearData, BTvel, Q, BTamp, StructureReport] = ...
    buildProcessingStructures1200( ...
        ADCPin, ...
        WaterProfileOut, ...
        DepthRNGout, ...
        ShearStressOut, ...
        BTvelOut, ...
        BedloadTransportOut, ...
        BackscatterOut, ...
        'Acoustic', Acoustic, ...
        'Folder1200', Folder1200, ...
        'FolderTrates', FolderTrates, ...
        'FolderShear', FolderShear, ...
        'FolderBS', FolderBS, ...
        'dataADCP1200', dataADCP1200, ...
         'LocationName', 'Tomorrica', ...
        'UseCallerWorkspace', true, ...
        'AssignToCaller', true, ...
        'Verbose', true);


DatePrefix = '20170322';

TratesFile = fullfile( ...
    FolderTrates, ...
    [DatePrefix '_TratesData.mat']);

ShearFile = fullfile( ...
    FolderShear, ...
    [DatePrefix '_ShearData.mat']);

BackscatterFile = fullfile( ...
    FolderBS, ...
    [DatePrefix '_BackscatterData.mat']);


ValidationReport = validateFeatureExtractionStructures1200( ...
    TratesFile, ...
    ShearFile, ...
    BackscatterFile, ...
    'ThrowOnMissing', true, ...
    'ThrowOnPlaceholder', false, ...
    'ThrowOnDateMismatch', true, ...
    'Verbose', true);

